{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exdsgift.github.io/aseri/api/v1/schemas/forecast-index.schema.json",
  "title": "series/{series_id}/forecasts.json: every forecast issued",
  "description": "The index of a series' dated forecast files, oldest reference date first: a static host cannot list a directory.",
  "type": "object",
  "required": ["schema_version", "series_id", "forecasts", "generated_at"],
  "properties": {
    "schema_version": {"$ref": "defs.schema.json#/$defs/schema_version"},
    "series_id": {"$ref": "defs.schema.json#/$defs/series_id"},
    "forecasts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["reference_date", "forecast_date", "forecast_mode", "url"],
        "properties": {
          "reference_date": {"$ref": "defs.schema.json#/$defs/date"},
          "forecast_date": {"$ref": "defs.schema.json#/$defs/date"},
          "forecast_mode": {"$ref": "defs.schema.json#/$defs/forecast_mode"},
          "url": {"$ref": "defs.schema.json#/$defs/path", "description": "Its dated file, relative to this one."}
        }
      }
    },
    "generated_at": {"$ref": "defs.schema.json#/$defs/timestamp"}
  }
}
